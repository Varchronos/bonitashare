# Keys for the Doppler `prd_api` config. Nothing reads this file: docker-compose.prod.yml fetches these
# from Doppler at container start. The migrate service uses this config too (it only needs DATABASE_URL).

# Postgres and Redis run in the same compose project on the VPS.
# User, password and db name must match the prd_db config.
DATABASE_URL=postgresql://pgdhruv:change-me@postgres:5432/bonitasharedb
REDIS_URL=redis://redis:6379

# Cloudflare R2: the account's S3 API endpoint, without a bucket path. There is no internal/public
# split on R2, so S3_PUBLIC_ENDPOINT is left unset and presigned URLs use this endpoint.
S3_ENDPOINT=get_from_cloudfare
S3_REGION=auto
S3_FORCE_PATH_STYLE=true
# R2 API token with Object Read & Write on the three buckets below.
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me-too
S3_BUCKET=files
# The thumbs and HLS buckets are public through their custom domains, so URLs handed to browsers use
# those rather than the S3 endpoint. The HLS bucket needs a CORS rule allowing GET from the web origin.
S3_THUMB_BUCKET=thumbs
THUMB_PUBLIC_BASE_URL=https://thumbs.dhruvrajak.dev
S3_HLS_BUCKET=hls
HLS_PUBLIC_BASE_URL=https://videos.dhruvrajak.dev

# Signs session cookies. Generate with: openssl rand -hex 32
COOKIE_SECRET=change-me
# Optional: shared parent domain (e.g. .dhruvrajak.dev) if web and api end up on different subdomains.
# COOKIE_DOMAIN=

# Days until files uploaded by anonymous users (no email) expire.
ANONYMOUS_UPLOAD_TTL_DAYS=30
