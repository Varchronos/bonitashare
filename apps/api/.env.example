# Postgres — user, password and db name from .env.db
DATABASE_URL=postgresql://pgdhruv:change-me@postgres:5432/bonitasharedb

# Redis
REDIS_URL=redis://redis:6379

# MinIO (S3-compatible) — same client code will work against R2/B2/S3 in prod,
# just swap these values and drop S3_FORCE_PATH_STYLE
S3_ENDPOINT=http://storage:9000
# Used only for presigning URLs handed to the browser — must be reachable from
# outside the docker network. In prod (hosted S3/R2) this is usually the same
# as S3_ENDPOINT, since there's no internal-vs-public split.
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
# Locally these are MINIO_ROOT_USER / MINIO_ROOT_PASSWORD from .env.storage.
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me-too
S3_BUCKET=files
# Public-read bucket for generated thumbnails, served directly to browsers.
S3_THUMB_BUCKET=thumbs
# Optional: base URL thumbnails are served from (CDN / R2 custom domain).
# Defaults to S3_PUBLIC_ENDPOINT/S3_THUMB_BUCKET.
# THUMB_PUBLIC_BASE_URL=
# Public-read bucket for HLS playlists and segments, served directly to video players.
S3_HLS_BUCKET=hls
# Optional: base URL HLS is served from. Defaults to S3_PUBLIC_ENDPOINT/S3_HLS_BUCKET.
# HLS_PUBLIC_BASE_URL=
S3_FORCE_PATH_STYLE=true

# Signs session cookies. Generate with: openssl rand -hex 32
COOKIE_SECRET=change-me
# Optional: shared parent domain in prod (e.g. .example.com) so the web app and
# API both receive the session cookie. Leave unset locally.
# COOKIE_DOMAIN=

# Days until files uploaded by anonymous users (no email) expire.
ANONYMOUS_UPLOAD_TTL_DAYS=30
