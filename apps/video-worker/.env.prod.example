# Keys for the Doppler `prd_video-worker` config. Nothing reads this file: docker-compose.video-worker.yml
# fetches these from Doppler at container start.

# Runs on a different machine from the VPS, so Postgres and Redis are reached at the VPS's
# private-network address (the PRIVATE_BIND_IP that docker-compose.prod.yml publishes them on).
DATABASE_URL=postgresql://pgdhruv:change-me@<vps-private-ip>:5432/bonitasharedb
REDIS_URL=redis://<vps-private-ip>:6379

# Cloudflare R2, same token and buckets as the api. Server-to-server only, so no public URLs.
S3_ENDPOINT=get_from_cloudfare
S3_REGION=auto
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me-too
S3_BUCKET=files
S3_THUMB_BUCKET=thumbs
S3_HLS_BUCKET=hls
