---
import Navbar from '../components/Navbar.astro';
import '../styles/global.css';

interface Props {
	title?: string;
	// Search results and link previews. Falls back to a line about the site.
	description?: string;
	// Absolute URL; left out entirely when absent so unfurlers don't get an empty image.
	ogImage?: string | null;
	// A small video unfurlers can play inline (Discord, Telegram, Slack…). Absolute URL.
	ogVideo?: { url: string; type: string; width?: number | null; height?: number | null } | null;
}

const DEFAULT_DESCRIPTION = 'Share files fast: drop them in and get a link. No install needed.';

const { title, description = DEFAULT_DESCRIPTION, ogImage, ogVideo } = Astro.props;
const fullTitle = title ? `${title} · bonitashare` : 'bonitashare';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{fullTitle}</title>
		<meta name="description" content={description} />
		<meta property="og:site_name" content="bonitashare" />
		<meta property="og:title" content={title ?? 'bonitashare'} />
		<meta property="og:description" content={description} />
		{ogImage && <meta property="og:image" content={ogImage} />}
		{ogImage && <meta name="twitter:card" content="summary_large_image" />}
		{
			ogVideo && (
				<>
					<meta property="og:type" content="video.other" />
					<meta property="og:video" content={ogVideo.url} />
					{ogVideo.url.startsWith('https:') && <meta property="og:video:secure_url" content={ogVideo.url} />}
					<meta property="og:video:type" content={ogVideo.type} />
					{ogVideo.width && <meta property="og:video:width" content={String(ogVideo.width)} />}
					{ogVideo.height && <meta property="og:video:height" content={String(ogVideo.height)} />}
				</>
			)
		}
	</head>
	<body>
		<Navbar />
		<main>
			<slot />
		</main>
	</body>
</html>
