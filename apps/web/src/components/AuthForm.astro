---
interface Props {
	mode: 'login' | 'signup';
}

const { mode } = Astro.props;
const isSignup = mode === 'signup';
// Read per request (process.env, not import.meta.env), so it comes from Doppler at runtime, not build time.
const turnstileSiteKey = process.env.TURNSTILE_SITE_KEY;
---

<section class="mx-auto flex w-full max-w-page justify-center px-4 py-16">
	<div class="w-full max-w-100 rounded-[28px] bg-surface-container-low px-6 py-8 sm:px-8">
		<h1 class="mb-2 text-headline">{isSignup ? 'Create your account' : 'Welcome back'}</h1>
		<p class="mb-10 text-sm text-on-surface-variant">{isSignup ? 'Keep your uploads in one place.' : 'Log in to manage your files.'}</p>

		<!-- method="post" so credentials never end up in the URL, even if the script below hasn't loaded -->
		<form method="post" class="flex flex-col gap-8" data-auth-form={mode}>
			{
				isSignup && (
					<label class="relative block">
						<input name="displayName" type="text" autocomplete="name" maxlength="50" required placeholder=" " class="peer h-12 w-full rounded-md bg-surface-container px-4 text-base text-on-surface outline-none hover:border-on-surface focus:border-2 focus:border-primary focus:px-[15px]" />
						<span class="pointer-events-none absolute top-1/2 left-3 -translate-y-1/2 px-1 text-base text-on-surface-variant transition-all peer-focus:-top-3 peer-focus:left-0 peer-focus:text-xs peer-focus:text-primary peer-[:not(:placeholder-shown)]:top-0 peer-[:not(:placeholder-shown)]:text-xs">Display name</span>
					</label>
				)
			}
			<label class="relative block">
				<input name="email" type="email" autocomplete="email" maxlength="254" required placeholder=" " class="peer h-12 w-full rounded-md bg-surface-container px-4 text-base text-on-surface outline-none hover:border-on-surface focus:border-2 focus:border-primary focus:px-[15px]" />
				<span class="pointer-events-none absolute top-1/2 left-3 -translate-y-1/2 px-1 text-base text-on-surface-variant transition-all peer-focus:-top-3 peer-focus:left-0 peer-focus:text-xs peer-focus:text-primary peer-[:not(:placeholder-shown)]:top-0 peer-[:not(:placeholder-shown)]:text-xs">Email</span>
			</label>
			<label class="relative block">
				<input
					name="password"
					type="password"
					autocomplete={isSignup ? 'new-password' : 'current-password'}
					minlength={isSignup ? 8 : undefined}
					maxlength="128"
					required
					placeholder=" "
					class="peer h-12 w-full rounded-md bg-surface-container px-4 text-base text-on-surface outline-none hover:border-on-surface focus:border-2 focus:border-primary focus:px-[15px]"
				/>
				<span class="pointer-events-none absolute top-1/2 left-3 -translate-y-1/2 px-1 text-base text-on-surface-variant transition-all peer-focus:-top-3 peer-focus:left-0 peer-focus:text-xs peer-focus:text-primary peer-[:not(:placeholder-shown)]:top-0 peer-[:not(:placeholder-shown)]:text-xs">Password</span>
			</label>
			{
				// Turnstile adds a hidden cf-turnstile-response input to the form once solved. data-action has to
				// match TURNSTILE_SIGNUP_ACTION in the API's routes/auth.ts.
				isSignup && (
					<>
						<div class="cf-turnstile -my-4" data-sitekey={turnstileSiteKey} data-action="signup" data-theme="auto" data-size="flexible" />
						<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer />
					</>
				)
			}
			<p data-auth-error role="alert" class="-my-4 text-sm text-error empty:hidden"></p>
			<button type="submit" class="btn btn-filled mt-2 w-full">{isSignup ? 'Sign up' : 'Log in'}</button>
		</form>

		<p class="mt-6 text-center text-sm text-on-surface-variant">
			{
				isSignup ? (
					<>Already have an account? <a href="/login" class="btn btn-text btn-sm">Log in</a></>
				) : (
					<>New to bonitashare? <a href="/signup" class="btn btn-text btn-sm">Sign up</a></>
				)
			}
		</p>
	</div>
</section>

<script>
	import type { ApiResponse, LoggedIn, OtpSent } from '@bonitashare/shared-types';
	import { savePendingSignup } from '../lib/pending-signup';

	// From the Turnstile script, which only the signup form loads.
	declare global {
		interface Window {
			turnstile?: { reset(widget?: string | HTMLElement): void };
		}
	}

	const form = document.querySelector<HTMLFormElement>('form[data-auth-form]');
	const errorEl = form?.querySelector<HTMLElement>('[data-auth-error]');
	const submit = form?.querySelector<HTMLButtonElement>('button[type=submit]');

	async function post<T>(path: string, body: object): Promise<ApiResponse<T>> {
		const res = await fetch(`/api/v1/auth/${path}`, {
			method: 'POST',
			headers: { 'content-type': 'application/json' },
			body: JSON.stringify(body),
		});
		return (await res.json()) as ApiResponse<T>;
	}

	form?.addEventListener('submit', async (event) => {
		event.preventDefault();
		if (!errorEl || !submit) return;
		errorEl.textContent = '';

		const fields = new FormData(form);
		const email = fields.get('email');
		const password = fields.get('password');
		submit.disabled = true;
		try {
			if (form.dataset.authForm === 'login') {
				const body = await post<LoggedIn>('login', { email, password });
				// Already signed in counts as done: the account page is where they belong either way.
				if (body.error && body.error.code !== 'ALREADY_SIGNED_IN') {
					errorEl.textContent = body.error.message;
					return;
				}
				location.assign('/account');
				return;
			}

			const turnstileToken = fields.get('cf-turnstile-response');
			if (!turnstileToken) {
				errorEl.textContent = 'Wait for the security check to finish, then try again.';
				return;
			}
			const body = await post<OtpSent>('signup', { displayName: fields.get('displayName'), email, password, turnstileToken });
			if (body.error) {
				if (body.error.code === 'ALREADY_SIGNED_UP') return void location.assign('/account');
				errorEl.textContent = body.error.message;
				// A token works once, so the next try needs a new one.
				window.turnstile?.reset();
				return;
			}
			savePendingSignup(body.data);
			location.assign('/verify');
		} catch {
			errorEl.textContent = "Couldn't reach the server. Check your connection and try again.";
			// The request may still have reached the server and used the token up.
			window.turnstile?.reset();
		} finally {
			submit.disabled = false;
		}
	});
</script>
