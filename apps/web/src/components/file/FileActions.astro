---
import ReportFile from "../ReportFile";

interface Props {
	fileId: string;
	filename: string;
	downloadUrl: string;
	// Off for the uploader's own files and for files already taken down.
	canReport: boolean;
	signedIn: boolean;
}

const { fileId, filename, downloadUrl, canReport, signedIn } = Astro.props;
---

<div class="flex flex-wrap items-center gap-3">
	<a class="btn btn-filled" href={downloadUrl}>
		<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
			<path d="M12 4v12m0 0-5-5m5 5 5-5M5 20h14" />
		</svg>
		Download file
	</a>
	{canReport && <ReportFile client:idle fileId={fileId} filename={filename} signedIn={signedIn} />}
</div>
