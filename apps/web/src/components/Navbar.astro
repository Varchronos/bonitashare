---
import logo from '../assets/logo.png';

const links = [
	{ href: '/', label: 'Home' },
	{ href: '/upload', label: 'Uploads' },
	// { href: '/login', label: 'Login' }, // hide for now since not implemented
];
// On phones Uploads stays in the bar; the rest move into the menu.
const menuLinks = links.filter(({ href }) => href !== '/upload');

const path = Astro.url.pathname.replace(/\/$/, '') || '/';

const navItem =
	'state-layer flex h-10 items-center rounded-full px-4 text-sm font-medium text-on-surface-variant aria-[current=page]:bg-secondary-container aria-[current=page]:text-on-secondary-container';
---

<!-- M3 top app bar: the surface colour, no divider. `group` lets the menu button swap icons while the menu is open. -->
<header class="group sticky top-0 z-10 bg-surface">
	<nav class="mx-auto flex h-16 w-full max-w-page items-center justify-between gap-4 px-4">
		<a href="/" class="flex items-center gap-3 text-title text-on-surface" aria-label="bonitashare home">
			<img class="overflow-hidden rounded" src={logo.src} alt="" width="28" height="28" />
			<span>bonitashare</span>
		</a>

		<!-- Wide screens: everything in the bar. -->
		<ul class="hidden items-center gap-1 sm:flex">
			{
				links.map(({ href, label }) => (
					<li>
						<a href={href} aria-current={path === href ? 'page' : undefined} class={navItem}>
							{label}
						</a>
					</li>
				))
			}
			<li>
				<button type="button" data-theme-toggle aria-label="Toggle dark mode" class="icon-btn">
					<!-- Moon in light mode, sun in dark: the icon shows what a click switches to. -->
					<svg class="dark:hidden" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" />
					</svg>
					<svg class="hidden dark:block" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<circle cx="12" cy="12" r="4" />
						<path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4m11.4-11.4 1.4-1.4" />
					</svg>
				</button>
			</li>
			<!-- hide for now not implemented -->
			<!-- <li>
				<a href="/signup" class="btn btn-filled ml-2" aria-current={path === '/signup' ? 'page' : undefined}>
					Sign up
				</a>
			</li> -->
		</ul>

		<!-- Phones: Uploads and the menu button. -->
		<div class="flex items-center gap-1 sm:hidden">
			<a href="/upload" aria-current={path === '/upload' ? 'page' : undefined} class={navItem}>Uploads</a>
			<!-- popovertarget opens and closes the menu, with Escape and outside-tap dismissal and aria-expanded, without script. -->
			<button type="button" popovertarget="nav-menu" aria-label="Menu" class="icon-btn">
				<svg class="group-has-[#nav-menu:popover-open]:hidden" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true">
					<path d="M4 7h16M4 12h16M4 17h16" />
				</svg>
				<svg class="hidden group-has-[#nav-menu:popover-open]:block" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true">
					<path d="M6 6l12 12M18 6 6 18" />
				</svg>
			</button>
		</div>
	</nav>

	<!-- The phone menu, dropping down under the bar. A popover sits in the top layer, so it's fixed to the
	     viewport; `hidden open:flex` because a display utility would otherwise override the browser's
	     hiding of a closed popover. The backdrop starts under the bar, leaving the close button tappable. -->
	<div
		id="nav-menu"
		popover
		class="fixed inset-x-0 top-16 bottom-auto m-0 hidden w-full max-w-none flex-col gap-1 rounded-b-3xl border-0 bg-surface-container p-3 text-on-surface shadow-lg open:flex sm:open:hidden backdrop:top-16 backdrop:bg-black/40"
	>
		{
			menuLinks.map(({ href, label }) => (
				<a href={href} aria-current={path === href ? 'page' : undefined} class={`${navItem} h-12`}>
					{label}
				</a>
			))
		}
		<button type="button" data-theme-toggle class={`${navItem} h-12 cursor-pointer gap-3`}>
			<svg class="dark:hidden" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" />
			</svg>
			<svg class="hidden dark:block" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<circle cx="12" cy="12" r="4" />
				<path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4m11.4-11.4 1.4-1.4" />
			</svg>
			<span class="dark:hidden">Dark mode</span>
			<span class="hidden dark:inline">Light mode</span>
		</button>
		<!-- <a href="/signup" class="btn btn-filled mt-2 w-full" aria-current={path === '/signup' ? 'page' : undefined}>
			Sign up
		</a> -->
	</div>
</header>

<script>
	// A tap on the backdrop reaches the menu element itself, so the browser can count it as inside the
	// popover and leave it open. Close it when the tap lands outside the panel's box.
	const menu = document.getElementById('nav-menu');
	menu?.addEventListener('click', (e) => {
		if (e.target !== menu) return;
		const box = menu.getBoundingClientRect();
		const inside = e.clientX >= box.left && e.clientX <= box.right && e.clientY >= box.top && e.clientY <= box.bottom;
		if (!inside) menu.hidePopover();
	});

	for (const toggle of document.querySelectorAll('[data-theme-toggle]')) {
		toggle.addEventListener('click', () => {
			const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
			document.documentElement.dataset.theme = next;
			try {
				localStorage.setItem('theme', next);
			} catch {
				// Storage blocked (private mode, site data off): the switch still applies for this page.
			}
		});
	}
</script>
