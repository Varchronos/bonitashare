---
import logo from "../assets/logo.png";
import HamburgerIcon from "../assets/hamburger.svg";
import MoonIcon from "../assets/moon.svg";
import SunIcon from "../assets/sun.svg";
import UserIcon from "../assets/user.svg";
import XmarkIcon from "../assets/xmark.svg";
import { currentAccount } from "../lib/account";
import Tooltip from "./Tooltip";

// Signed in means an account with an email; an anonymous session still gets Login and Sign up.
const signedIn = Boolean((await currentAccount(Astro))?.email);

const links = [
	{ href: "/", label: "Home" },
	{ href: "/upload", label: "Uploads" },
	{ href: "/about", label: "About" },
	...(signedIn ? [] : [{ href: "/login", label: "Login" }]),
];
// The end of the bar (and the menu): a filled Sign up button, or once signed in a link to the account
// page, shown in the bar as a user icon.
const cta = signedIn
	? { href: "/account", label: "My Account" }
	: { href: "/signup", label: "Sign up" };
// On phones Uploads stays in the bar; the rest move into the menu.
const menuLinks = links.filter(({ href }) => href !== "/upload");

const path = Astro.url.pathname.replace(/\/$/, "") || "/";

const navItem =
	"state-layer flex h-10 items-center rounded-full px-4 text-sm font-medium text-on-surface-variant aria-[current=page]:bg-secondary-container aria-[current=page]:text-on-secondary-container";
---

<!-- M3 top app bar: the surface colour, no divider. `group` lets the menu button swap icons while the menu is open. -->
<header class="group sticky top-0 z-10 bg-surface">
	<nav
		class="mx-auto flex h-16 w-full max-w-page items-center justify-between gap-4 px-4"
	>
		<a
			href="/"
			class="flex items-center gap-3 text-title text-on-surface"
			aria-label="bonitashare home"
		>
			<img
				class="overflow-hidden rounded"
				src={logo.src}
				alt=""
				width="28"
				height="28"
			/>
			<span>bonitashare</span>
		</a>

		<!-- Wide screens: everything in the bar. -->
		<ul class="hidden items-center gap-1 sm:flex">
			{
				links.map(({ href, label }) => (
					<li>
						<a
							href={href}
							aria-current={path === href ? "page" : undefined}
							class={navItem}
						>
							{label}
						</a>
					</li>
				))
			}
			<li>
				<Tooltip label="Toggle dark mode">
					<button
						type="button"
						data-theme-toggle
						aria-label="Toggle dark mode"
						class="icon-btn"
					>
						<!-- Moon in light mode, sun in dark: the icon shows what a click switches to. -->
						<MoonIcon class="dark:hidden" width="20" height="20" fill="currentColor" aria-hidden="true" />
						<SunIcon class="hidden dark:block" width="20" height="20" fill="currentColor" aria-hidden="true" />
					</button>
				</Tooltip>
			</li>
			<li>
				{
					signedIn ? (
						<Tooltip label={cta.label}>
							<a
								href={cta.href}
								aria-label={cta.label}
								aria-current={path === cta.href ? "page" : undefined}
								class="icon-btn aria-[current=page]:bg-secondary-container aria-[current=page]:text-on-secondary-container"
							>
								<UserIcon width="22" height="22" fill="currentColor" aria-hidden="true" />
							</a>
						</Tooltip>
					) : (
						<a
							href={cta.href}
							class="btn btn-filled ml-2"
							aria-current={path === cta.href ? "page" : undefined}
						>
							{cta.label}
						</a>
					)
				}
			</li>
		</ul>

		<!-- Phones: Uploads and the menu button. -->
		<div class="flex items-center gap-1 sm:hidden">
			<a
				href="/upload"
				aria-current={path === "/upload" ? "page" : undefined}
				class={navItem}>Uploads</a
			>
			<!-- popovertarget opens and closes the menu, with Escape and outside-tap dismissal and aria-expanded, without script. -->
			<button
				type="button"
				popovertarget="nav-menu"
				aria-label="Menu"
				class="icon-btn"
			>
				<HamburgerIcon class="group-has-[#nav-menu:popover-open]:hidden" width="24" height="24" aria-hidden="true" />
				<XmarkIcon class="hidden group-has-[#nav-menu:popover-open]:block" width="24" height="24" aria-hidden="true" />
			</button>
		</div>
	</nav>

	<!-- The phone menu, dropping down under the bar. A popover sits in the top layer, so it's fixed to the
	     viewport; `hidden open:flex` because a display utility would otherwise override the browser's
	     hiding of a closed popover. The backdrop starts under the bar, leaving the close button tappable. -->
	<div
		id="nav-menu"
		popover
		class="fixed inset-x-0 top-16 bottom-auto m-0 hidden w-full max-w-none flex-col gap-1 rounded-b-3xl border-0 bg-surface-container p-3 text-on-surface shadow-lg open:flex sm:open:hidden backdrop:top-16 backdrop:bg-black/40"
	>
		{
			menuLinks.map(({ href, label }) => (
				<a
					href={href}
					aria-current={path === href ? "page" : undefined}
					class={`${navItem} h-12`}
				>
					{label}
				</a>
			))
		}
		<button
			type="button"
			data-theme-toggle
			class={`${navItem} h-12 cursor-pointer gap-3`}
		>
			<MoonIcon class="dark:hidden" width="20" height="20" fill="currentColor" aria-hidden="true" />
			<SunIcon class="hidden dark:block" width="20" height="20" fill="currentColor" aria-hidden="true" />
			<span class="dark:hidden">Dark mode</span>
			<span class="hidden dark:inline">Light mode</span>
		</button>
		<a
			href={cta.href}
			class="btn btn-filled mt-2 w-full"
			aria-current={path === cta.href ? "page" : undefined}
		>
			{cta.label}
		</a>
	</div>
</header>

<script>
	// A tap on the backdrop reaches the menu element itself, so the browser can count it as inside the
	// popover and leave it open. Close it when the tap lands outside the panel's box.
	const menu = document.getElementById("nav-menu");
	menu?.addEventListener("click", (e) => {
		if (e.target !== menu) return;
		const box = menu.getBoundingClientRect();
		const inside =
			e.clientX >= box.left &&
			e.clientX <= box.right &&
			e.clientY >= box.top &&
			e.clientY <= box.bottom;
		if (!inside) menu.hidePopover();
	});

	for (const toggle of document.querySelectorAll("[data-theme-toggle]")) {
		toggle.addEventListener("click", () => {
			const next =
				document.documentElement.dataset.theme === "dark"
					? "light"
					: "dark";
			document.documentElement.dataset.theme = next;
			try {
				localStorage.setItem("theme", next);
			} catch {
				// Storage blocked (private mode, site data off): the switch still applies for this page.
			}
		});
	}
</script>
