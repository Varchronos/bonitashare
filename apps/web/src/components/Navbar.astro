---
import logo from '../assets/logo.svg';

const links = [
	{ href: '/', label: 'Home' },
	{ href: '/upload', label: 'Uploads' },
	{ href: '/login', label: 'Login' },
];

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="sticky top-0 z-10 border-b border-border bg-page/85 backdrop-blur-sm">
	<nav class="mx-auto flex h-16 w-full max-w-page items-center justify-between gap-4 px-4">
		<a href="/" class="flex items-center gap-2.5 text-lg font-bold" aria-label="bonitashare home">
			<img src={logo.src} alt="" width="28" height="28" />
			<span class="max-[480px]:hidden">bonitashare</span>
		</a>

		<ul class="flex items-center gap-1">
			{
				links.map(({ href, label }) => (
					<li>
						<a
							href={href}
							aria-current={path === href ? 'page' : undefined}
							class="block rounded-lg px-3 py-2 font-medium text-muted hover:bg-accent-soft hover:text-fg aria-[current=page]:bg-accent-soft aria-[current=page]:text-fg max-[480px]:px-2"
						>
							{label}
						</a>
					</li>
				))
			}
			<li>
				<button
					type="button"
					id="theme-toggle"
					aria-label="Toggle dark mode"
					class="flex cursor-pointer items-center rounded-lg p-2 text-muted hover:bg-accent-soft hover:text-fg"
				>
					<!-- Moon in light mode, sun in dark: the icon shows what a click switches to. -->
					<svg class="dark:hidden" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" />
					</svg>
					<svg class="hidden dark:block" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<circle cx="12" cy="12" r="4" />
						<path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4m11.4-11.4 1.4-1.4" />
					</svg>
				</button>
			</li>
			<li>
				<a href="/signup" class="btn btn-primary ml-1 px-3.5 py-2" aria-current={path === '/signup' ? 'page' : undefined}>
					Sign up
				</a>
			</li>
		</ul>
	</nav>
</header>

<script>
	document.getElementById('theme-toggle')?.addEventListener('click', () => {
		const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
		document.documentElement.dataset.theme = next;
		try {
			localStorage.setItem('theme', next);
		} catch {
			// Storage blocked (private mode, site data off): the switch still applies for this page.
		}
	});
</script>
