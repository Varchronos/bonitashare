---
import Layout from '../layouts/Layout.astro';
import VerifyCode from '../components/auth/VerifyCode';
import { getSession } from '../lib/session';
import { currentAccount } from '../lib/account';

// Same as /signup: the code only works for the session that started it, so renew it if it expired.
await getSession(Astro);
const account = await currentAccount(Astro);
if (account?.email) return Astro.redirect('/account');
---

<Layout noindex title="Verify your email" description="Enter the code we emailed you to finish creating your bonitashare account.">
	<VerifyCode client:load />
</Layout>
