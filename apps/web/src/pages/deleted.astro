---
import Layout from '../layouts/Layout.astro';
import DeletedFiles from '../components/upload/DeletedFiles';
import { getSession } from '../lib/session';
import { getDeletedFiles } from '../lib/files';

const { cookie } = await getSession(Astro);
const files = await getDeletedFiles(cookie);
---

<Layout title="Recently deleted" description="Files you deleted in the last day, which you can still restore.">
	<section class="container page">
		<h1>Recently deleted</h1>
		<p>Deleted files can be restored for a day. After that they're removed for good.</p>
		<DeletedFiles client:load files={files} />
		<a class="back" href="/upload">Back to uploads</a>
	</section>
</Layout>

<style>
	.page {
		max-width: 640px;
		padding-top: 48px;
		padding-bottom: 48px;
	}

	h1 {
		margin: 0 0 8px;
	}

	p {
		margin: 0 0 24px;
		color: var(--muted);
	}

	.back {
		display: inline-block;
		margin-top: 24px;
	}
</style>
