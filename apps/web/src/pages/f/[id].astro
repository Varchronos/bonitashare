---
import Layout from "../../layouts/Layout.astro";
import { REPORT_REASON_OPTIONS, TAKEDOWN_STATE_OPTIONS, formatBytes } from "@bonitashare/shared-types";
import { getFileLink, getFileVideo } from "../../lib/file";
import { currentAccount } from "../../lib/account";
import ReportFile from "../../components/ReportFile";
import TakedownTool from "../../components/TakedownTool";
import warningIcon from "../../assets/warning.svg?raw";

const { id } = Astro.params;
const { data: file, error, cookie } = await getFileLink(Astro, id!);

if (!file) {
	Astro.response.status = error?.code === "FILE_EXPIRED" || error?.code === "FILE_TAKEN_DOWN" ? 410 : 404;
}

const isImage = file?.contentType?.startsWith("image/") ?? false;
const isVideo = file?.contentType?.startsWith("video/") ?? false;
const isAudio = file?.contentType?.startsWith("audio/") ?? false;

// Only the stream URL is decided here; hls.js attaches in the browser (see the script below).
// Anything short of a finished transcode plays the original file directly.
const video = isVideo ? (await getFileVideo(cookie, id!)).data : null;
const hlsUrl = video?.hlsUrl ?? null;

// Link previews: the thumbnail, or for an image without one yet (the worker makes it shortly after
// upload, which is when links get shared) the image itself if it's small enough for unfurlers to fetch.
const OG_IMAGE_MAX_BYTES = 5 * 1024 * 1024;
const ogImage = file?.thumbnailUrl ?? (isImage && file && file.sizeBytes <= OG_IMAGE_MAX_BYTES ? file.url : null);

// Small videos play inline in link previews. Formats unfurlers can play, and a size they'll fetch
// without stalling the preview. Points at /f/<id>/raw rather than the presigned URL: unfurlers keep
// the embed for days and fetch the video only when someone presses play, long after a presigned URL
// has expired; /raw signs a fresh one each time.
const OG_VIDEO_MAX_BYTES = 5 * 1024 * 1024;
const OG_VIDEO_TYPES = new Set(["video/mp4", "video/webm"]);
const ogVideo =
	file?.contentType && OG_VIDEO_TYPES.has(file.contentType) && file.sizeBytes <= OG_VIDEO_MAX_BYTES
		? {
				url: new URL(`/f/${encodeURIComponent(id!)}/raw`, Astro.url).toString(),
				type: file.contentType,
				// Known once the video-worker has probed the file.
				width: video?.width,
				height: video?.height,
			}
		: null;

// Private and missing files get the same text as each other, so a preview doesn't reveal which it is.
const kind = isImage ? "Image" : isVideo ? "Video" : isAudio ? "Audio" : "File";
const description = file
	? `${kind} shared on bonitashare · ${formatBytes(file.sizeBytes)}${file.contentType ? ` · ${file.contentType}` : ""}`
	: error?.code === "FILE_EXPIRED"
		? "This file has expired and is no longer available."
		: error?.code === "FILE_TAKEN_DOWN"
			? "This file was taken down and is no longer available."
			: "This file doesn't exist or isn't available.";

// Capped at 75% of the screen's height so a portrait image or video fits without scrolling; it then
// narrows to keep its shape (object-contain covers anything that doesn't match exactly) and centres.
const MEDIA_MAX_HEIGHT = "70svh";
const mediaClass = "mx-auto block h-auto w-auto max-h-[75svh] max-w-full rounded-2xl object-contain";
// w-auto drops the width attribute's sizing, so before it loads a video would be a 300×150 box. With the
// probe's dimensions, size the box to the video's shape instead: as wide as fits the height cap, never
// past the column or the video's own width. Reserves the right space before playback starts.
const videoBox =
	video?.width && video?.height
		? `aspect-ratio: ${video.width} / ${video.height}; width: min(100%, ${video.width}px, calc(${MEDIA_MAX_HEIGHT} * ${video.width} / ${video.height}));`
		: undefined;
const videoClass = `${mediaClass} border border-outline-variant dark:border-0`;

// For the homepage's "Shared with you": other people's files are recorded, your own aren't (they're
// under your uploads). Signed in, on the server (lib/visits.ts); anonymous, in this browser's IndexedDB
// (lib/recent-visits.ts), where a link that no longer works is also dropped. The server leaves those
// out when it reads the list. The navbar asks for the account anyway, so this costs no extra call.
const account = await currentAccount(Astro);
const signedIn = Boolean(account?.email);
// The takedown tool at the bottom. The API will check the role again once the tool is wired up.
const isAdmin = signedIn && account?.role === "admin";

const takedownLabel = file?.takedown ? TAKEDOWN_STATE_OPTIONS.find((o) => o.value === file.takedown!.state)?.label.toLowerCase() : null;
const takedownReason = file?.takedown
	? (REPORT_REASON_OPTIONS.find((o) => o.value === file.takedown!.reason)?.label ?? file.takedown.reason).toLowerCase()
	: null;
const visit =
	file && !file.isOwner && !file.takedown
		? {
				id: id!,
				filename: file.filename,
				contentType: file.contentType,
				sizeBytes: file.sizeBytes,
				thumbnailUrl: file.thumbnailUrl,
			}
		: null;
---

<Layout title={file?.filename ?? "File not found"} description={description} ogImage={ogImage} ogVideo={ogVideo}>
	<section class="mx-auto w-full max-w-page px-4 py-12">
		{
			file ? (
				<>
					{file.takedown && (
						<p role="status" class="mb-6 flex items-start gap-2 rounded-lg bg-error-container px-4 py-3 text-sm text-on-error-container">
							<span aria-hidden="true" class="mt-0.5 inline-flex shrink-0 [&>svg]:size-4 [&>svg]:fill-current" set:html={warningIcon} />
							<span>
								{isAdmin ? (
									<>
										Taken down: <strong>{takedownLabel}</strong> for {takedownReason}.
										{file.takedown.state === "removed" && file.takedown.purgeContentAfter && (
											<>
												{" "}The content is deleted after{" "}
												<time data-local datetime={file.takedown.purgeContentAfter}>{new Date(file.takedown.purgeContentAfter).toUTCString()}</time>.
											</>
										)}
										{" "}Only admins{file.takedown.state === "hidden" ? " and the uploader" : ""} can open it.
									</>
								) : (
									<>
										This file was taken down for {takedownReason}. Only you can still open it; anyone else with the link is told it was taken down.
									</>
								)}
							</span>
						</p>
					)}
					<h1 class="mb-2 text-headline wrap-break-word">{file.filename}</h1>
					<p class="mb-6 text-sm text-on-surface-variant">
						{formatBytes(file.sizeBytes)}
						{file.contentType ? ` · ${file.contentType}` : ""}
					</p>

					<div class="mb-6">
						{isImage && <img src={file.url} alt={file.filename} class={mediaClass} />}
						{isVideo &&
							(hlsUrl ? (
								<video
									class={videoClass}
									style={videoBox}
									data-hls-src={hlsUrl}
									data-fallback-src={file.url}
									poster={file.thumbnailUrl ?? undefined}
									width={video?.width ?? undefined}
									height={video?.height ?? undefined}
									controls
									playsinline
									preload="metadata"
								/>
							) : (
								<>
									<video
										class={videoClass}
										style={videoBox}
										src={file.url}
										poster={file.thumbnailUrl ?? undefined}
										controls
										playsinline
										preload="metadata"
									/>
									{video?.status === "pending" && (
										<p class="mt-2 text-sm text-on-surface-variant">
											A streaming version is still processing. Playing the
											original for now.
										</p>
									)}
								</>
							))}
						{isAudio && <audio src={file.url} controls class="w-full" />}
						{!isImage && !isVideo && !isAudio && (
							<p class="card p-8 text-center text-on-surface-variant">
								No preview available for this file type.
							</p>
						)}
					</div>

					<div class="flex flex-wrap items-center gap-3">
						<a class="btn btn-filled" href={file.downloadUrl}>
							<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
								<path d="M12 4v12m0 0-5-5m5 5 5-5M5 20h14" />
							</svg>
							Download file
						</a>
						{!file.isOwner && !file.takedown && <ReportFile client:idle fileId={id!} filename={file.filename} signedIn={signedIn} />}
					</div>
				</>
			) : (
				<>
					<h1 class="mb-2 text-headline">
						{error?.code === "FILE_EXPIRED"
							? "This link has expired"
							: error?.code === "FILE_TAKEN_DOWN"
								? "This file was taken down"
								: "File not found"}
					</h1>
					<p class="mb-6 text-sm text-on-surface-variant">
						{error?.code === "FILE_EXPIRED"
							? "The file this link pointed to is no longer available."
							: error?.code === "FILE_TAKEN_DOWN"
								? "It broke our rules or was taken down on request, so it's no longer available."
								: "This link doesn't point to a file we have — check that you copied it correctly."}
					</p>
				</>
			)
		}
		{file && isAdmin && <TakedownTool client:idle fileId={id!} filename={file.filename} currentState={file.takedown?.state ?? null} defaultReason={file.takedown?.reason ?? null} />}
	</section>
	<div
		id="recent-visit"
		hidden
		data-visit={visit ? JSON.stringify(visit) : undefined}
		data-gone={file ? undefined : id}
		data-signed-in={signedIn ? "" : undefined}
	/>
</Layout>

<script>
	import { recordVisit, removeVisit } from "../../lib/recent-visits";
	import { recordRemoteVisit } from "../../lib/visits";

	// Admin notice times, in the viewer's own time zone (the server rendered them in UTC).
	const localTime = new Intl.DateTimeFormat(undefined, { dateStyle: "medium", timeStyle: "short" });
	for (const el of document.querySelectorAll<HTMLTimeElement>("time[data-local]")) {
		el.textContent = localTime.format(new Date(el.dateTime));
	}

	const recent = document.getElementById("recent-visit")?.dataset;
	// Not awaited: the player below shouldn't wait on the list, and failing (private window, offline) is fine.
	if (recent?.signedIn !== undefined) {
		if (recent.visit) recordRemoteVisit("file", JSON.parse(recent.visit).id).catch(() => {});
	} else if (recent?.visit) recordVisit(JSON.parse(recent.visit)).catch(() => {});
	else if (recent?.gone) removeVisit(recent.gone).catch(() => {});

	const player = document.querySelector<HTMLVideoElement>("video[data-hls-src]");

	if (player) {
		const src = player.dataset.hlsSrc!;
		// Presigned URL of the original; used when the stream can't be played at all.
		const fallback = player.dataset.fallbackSrc!;

		// Imported only on pages with a stream, so other file pages don't download hls.js.
		const { default: Hls } = await import("hls.js");

		// hls.js first, even where the browser plays HLS natively (Safari): it picks renditions more
		// smoothly and handles errors the same way everywhere. Native is for iOS versions without MSE.
		if (Hls.isSupported()) {
			const hls = new Hls();
			hls.on(Hls.Events.ERROR, (_event, data) => {
				// Non-fatal errors (a slow segment, a rendition switch) hls.js recovers from itself.
				if (!data.fatal) return;
				console.error("HLS playback failed, falling back to the original", data);
				hls.destroy();
				player.src = fallback;
			});
			hls.loadSource(src);
			hls.attachMedia(player);
		} else if (player.canPlayType("application/vnd.apple.mpegurl")) {
			player.src = src;
		} else {
			player.src = fallback;
		}
	}
</script>
