---
import Layout from '../layouts/Layout.astro';
import FileUpload from '../components/upload/FileUpload';
import { getSession } from '../lib/session';
import { getUsage } from '../lib/usage';
import { getFiles } from '../lib/files';

const { cookie } = await getSession(Astro);
const [usage, files] = await Promise.all([getUsage(cookie), getFiles(cookie)]);
---

<Layout title="Upload" description="Upload files and get a share link for each as soon as it finishes.">
	<section class="mx-auto w-full max-w-page px-4 py-16 max-[800px]:pt-8">
		<h1 class="mb-2 text-3xl font-bold">Upload files</h1>
		<p class="mb-6 text-muted">Drop in anything you want to share. You'll get a link once it's uploaded.</p>
		<FileUpload client:load usage={usage} files={files} />
		<a class="mt-6 inline-block text-muted underline" href="/deleted">Recently deleted</a>
	</section>
</Layout>
