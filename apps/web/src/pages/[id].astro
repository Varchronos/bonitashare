---
// Share pages moved to /f/<id>. Permanent redirect so links shared before the move keep working and
// search engines carry them over. Anything else at the root falls through to here too, and lands on
// /f/'s own not-found page.
const { id } = Astro.params;
return Astro.redirect(`/f/${encodeURIComponent(id!)}`, 301);
---
