# Keys for the Doppler `prd_worker` config. Nothing reads this file: docker-compose.prod.yml fetches
# these from Doppler at container start.

# Same Postgres and Redis as the api, in the same compose project on the VPS.
DATABASE_URL=postgresql://pgdhruv:change-me@postgres:5432/bonitasharedb
REDIS_URL=redis://redis:6379

# Cloudflare R2, same token and buckets as the api. Server-to-server only, so no public URLs.
S3_ENDPOINT=get_from_cloudfare
S3_REGION=auto
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me-too
S3_BUCKET=files
S3_THUMB_BUCKET=thumbs
