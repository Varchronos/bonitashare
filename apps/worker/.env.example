# Postgres — same database as the api
DATABASE_URL=postgresql://pgdhruv:change-me@postgres:5432/bonitasharedb

# Redis — same instance as the api; the queue lives here
REDIS_URL=redis://redis:6379

# MinIO (S3-compatible). The worker only talks to storage server-to-server, so it needs no public endpoint.
S3_ENDPOINT=http://storage:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me-too
S3_BUCKET=files
S3_THUMB_BUCKET=thumbs
S3_FORCE_PATH_STYLE=true
