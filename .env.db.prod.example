# Keys for the Doppler `prd_db` config, used by the postgres service in docker-compose.prod.yml.
# Nothing reads this file. USER and DB must match that service's healthcheck (pg_isready -U ... -d ...)
# and the DATABASE_URL in the prd_api, prd_worker and prd_video-worker configs.
POSTGRES_USER=pgdhruv
POSTGRES_PASSWORD=change-me
POSTGRES_DB=bonitasharedb
